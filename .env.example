# Flask
SECRET_KEY=change-this-to-a-long-random-value
FLASK_ENV=development
# development | production
APP_ENV=development

# Database
# Local dev default: sqlite:///garba.db
# Production example: postgresql://user:password@host:5432/garba
DATABASE_URL=sqlite:///garba.db

# Base URL used to build secure ticket links / QR payload URLs
BASE_URL=http://127.0.0.1:5000

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Mail (optional, for ticket delivery emails)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Initial admin bootstrap (used only by `flask create-admin` command)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_EMAIL=admin@example.com

# Rate limiting storage (optional; defaults to in-memory)
RATELIMIT_STORAGE_URI=memory://
